// Generic SLiM demographic simulation for validation.
// Supports: constant, bottleneck, growth, two-pop.
//
// Parameters (-d on command line):
//   scenario: "constant" | "bottleneck" | "growth" | "twopop"
//   Ne, L, mu, r: base parameters
//   burn_in: generations before sampling (should be 4*Ne minimum)
//   n_samp: number of diploid samples
//   seed: RNG seed
//   outfile: output path
//
//   Bottleneck params: t_bn_start, t_bn_end, N_bn
//   Growth params: g_rate (forward growth rate per gen)
//   Two-pop params: t_split_gen, mig_rate, N_pop2

initialize() {
    if (!exists("scenario")) defineConstant("scenario", "constant");
    if (!exists("Ne")) defineConstant("Ne", 10000);
    if (!exists("L")) defineConstant("L", 100000);
    if (!exists("mu")) defineConstant("mu", 1e-8);
    if (!exists("r")) defineConstant("r", 1e-8);
    if (!exists("burn_in")) defineConstant("burn_in", 80000);
    if (!exists("n_samp")) defineConstant("n_samp", 10);
    if (!exists("seed")) defineConstant("seed", 42);
    if (!exists("outfile")) defineConstant("outfile", "out.txt");

    // Scenario-specific
    if (!exists("t_bn_start")) defineConstant("t_bn_start", 5000);
    if (!exists("t_bn_end")) defineConstant("t_bn_end", 7000);
    if (!exists("N_bn")) defineConstant("N_bn", 100);
    if (!exists("g_rate")) defineConstant("g_rate", 0.001);
    if (!exists("t_split_gen")) defineConstant("t_split_gen", 5000);
    if (!exists("mig_rate")) defineConstant("mig_rate", 1e-4);
    if (!exists("N_pop2")) defineConstant("N_pop2", 10000);

    setSeed(seed);
    initializeMutationRate(mu);
    initializeMutationType("m1", 0.5, "f", 0.0);
    m1.convertToSubstitution = F;
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElement(g1, 0, L-1);
    initializeRecombinationRate(r);
}

1 early() {
    sim.addSubpop("p1", Ne);
    if (scenario == "twopop") {
        sim.addSubpop("p2", N_pop2);
        p1.setMigrationRates(p2, mig_rate);
        p2.setMigrationRates(p1, mig_rate);
    }
}

// Apply scenario-specific demographic events
1: early() {
    // Measure time backward from end of burn-in
    gens_from_end = burn_in + 1 - sim.cycle;

    if (scenario == "bottleneck") {
        if (gens_from_end == t_bn_start) {
            p1.setSubpopulationSize(N_bn);
            catn("gen " + sim.cycle + ": bottleneck starts, N=" + N_bn);
        }
        if (gens_from_end == t_bn_end) {
            p1.setSubpopulationSize(Ne);
            catn("gen " + sim.cycle + ": bottleneck ends, N=" + Ne);
        }
    }

    if (scenario == "growth") {
        // Exponential growth: N(t) = N0 * exp(g * t) forward
        if (gens_from_end <= burn_in/2) {
            // Growth phase: last half of simulation
            t_in_growth = burn_in/2 - gens_from_end;
            new_N = asInteger(Ne * exp(g_rate * t_in_growth));
            if (new_N != p1.individualCount) {
                p1.setSubpopulationSize(new_N);
            }
        }
    }

    if (scenario == "twopop") {
        if (gens_from_end == t_split_gen) {
            // Going backward: merge p2 into p1
            p2.setMigrationRates(p1, 1.0);  // all of p2 → p1
            p1.setMigrationRates(p2, 0.0);
            catn("gen " + sim.cycle + ": merging pops");
        }
    }
}

// Report occasionally
1: late() {
    if (sim.cycle % 20000 == 0) {
        n1 = p1.individualCount;
        msg = "gen " + sim.cycle + ": N_p1=" + n1;
        if (scenario == "twopop" & sim.subpopulations.size() > 1) {
            msg = msg + " N_p2=" + p2.individualCount;
        }
        catn(msg);
    }
}

// Sample and write output
80001 late() {
    if (scenario == "twopop" & sim.subpopulations.size() > 1 & p2.individualCount > 0) {
        s1 = sample(p1.individuals, asInteger(n_samp / 2));
        s2 = sample(p2.individuals, asInteger(n_samp / 2));
        sampled = c(s1, s2);
    } else {
        sampled = sample(p1.individuals, n_samp);
    }
    haps = sampled.haplosomes;

    out = "# SLiM " + scenario + ", n=" + size(haps) + ", L=" + L + "\n";
    out = out + "# seed=" + seed + ", Ne=" + Ne + "\n";

    muts = sim.mutations;
    muts = muts[muts.mutationType == m1];

    // Keep only variable sites
    keep = c();
    for (i in seqLen(size(muts))) {
        cnt = sum(haps.containsMutations(muts[i]));
        if (cnt > 0 & cnt < size(haps)) keep = c(keep, i);
    }
    if (size(keep) > 0) muts = muts[keep];
    else muts = object();

    positions = muts.position;
    if (size(positions) > 0) {
        order = order(positions);
        muts = muts[order];
        positions = positions[order];
    }

    out = out + "positions:";
    for (p in positions) out = out + " " + p;
    out = out + "\n";

    for (h in haps) {
        line = "";
        for (m in muts) line = line + (h.containsMutations(m) ? "1" else "0");
        out = out + line + "\n";
    }

    writeFile(outfile, out);
    catn("Wrote " + outfile);
    sim.simulationFinished();
}
