// Full inversion simulation in SLiM 5 with:
// - Proper recombination suppression in heterokaryotypes
// - Restart-on-extinction pattern (save state, reload if inversion lost)
//
// Parameters (via -d):
//   Ne, L, mu, r
//   INV_TICK: tick when inversion is introduced
//   END_TICK: tick at which to sample
//   bp_left, bp_right: inversion breakpoints
//   p_init: initial inversion frequency
//   n_samp: diploid samples per karyotype
//   seed, outfile

initialize() {
    if (!exists("Ne")) defineConstant("Ne", 10000);
    if (!exists("L")) defineConstant("L", 100000);
    if (!exists("mu")) defineConstant("mu", 1e-8);
    if (!exists("r")) defineConstant("r", 1e-8);
    if (!exists("INV_TICK")) defineConstant("INV_TICK", 40000);
    if (!exists("END_TICK")) defineConstant("END_TICK", 80000);
    if (!exists("bp_left")) defineConstant("bp_left", 30000);
    if (!exists("bp_right")) defineConstant("bp_right", 70000);
    if (!exists("p_init")) defineConstant("p_init", 0.5);
    if (!exists("n_samp")) defineConstant("n_samp", 10);
    if (!exists("seed")) defineConstant("seed", 42);
    if (!exists("outfile")) defineConstant("outfile", "inv_out.txt");

    setSeed(seed);
    initializeMutationRate(mu);
    initializeMutationType("m1", 0.5, "f", 0.0);
    m1.convertToSubstitution = F;
    initializeMutationType("m2", 0.5, "f", 0.0);
    m2.convertToSubstitution = F;
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElement(g1, 0, L-1);
    initializeRecombinationRate(r);

    // State save path (unique per run)
    defineGlobal("STATE_FILE", outfile + ".state");
    defineGlobal("restart_count", 0);
}

1 early() {
    sim.addSubpop("p1", Ne);
    // Schedule introduction and end
    community.rescheduleScriptBlock(s1, ticks=INV_TICK);
    community.rescheduleScriptBlock(s2, ticks=INV_TICK + 100);  // check frequency
    community.rescheduleScriptBlock(s3, ticks=END_TICK);
}

recombination() {
    h1 = haplosome1.containsMarkerMutation(m2, bp_left);
    h2 = haplosome2.containsMarkerMutation(m2, bp_left);
    if (h1 == h2) return F;
    keep = (breakpoints < bp_left) | (breakpoints >= bp_right);
    new_bps = breakpoints[keep];
    if (size(new_bps) == size(breakpoints)) return F;
    breakpoints = new_bps;
    return T;
}

// At INV_TICK: introduce inversion and save state
s1 100 late() {
    n_inv = asInteger(round(2 * Ne * p_init));
    targets = sample(p1.haplosomes, n_inv);
    targets.addNewDrawnMutation(m2, bp_left);
    sim.outputFull(STATE_FILE);
    catn("tick " + sim.cycle + ": introduced inversion, saved state");
}

// Check 100 ticks later — if lost, restart
s2 200 late() {
    n_inv = sum(p1.haplosomes.containsMarkerMutation(m2, bp_left));
    freq = n_inv / (2.0 * p1.individualCount);
    if (n_inv == 0 | n_inv == 2 * p1.individualCount) {
        // Lost or fixed — reload and try again
        restart_count = restart_count + 1;
        defineGlobal("restart_count", restart_count);
        catn("tick " + sim.cycle + ": inv " + (n_inv == 0 ? "lost" else "fixed") +
             ", restart #" + restart_count);
        if (restart_count > 100) {
            catn("Too many restarts, giving up");
            sim.simulationFinished();
            return;
        }
        sim.readFromPopulationFile(STATE_FILE);
        setSeed(seed + restart_count * 1000);
        // Re-schedule next check
        community.rescheduleScriptBlock(self, ticks=sim.cycle + 100);
    } else {
        catn("tick " + sim.cycle + ": inv freq = " + freq + " (ok)");
        // Schedule periodic checks
        if (sim.cycle + 2000 < END_TICK) {
            community.rescheduleScriptBlock(self, ticks=sim.cycle + 2000);
        }
    }
}

// At END_TICK: sample
s3 1000 late() {
    // Final check
    n_inv = sum(p1.haplosomes.containsMarkerMutation(m2, bp_left));
    if (n_inv == 0 | n_inv == 2 * p1.individualCount) {
        catn("tick " + sim.cycle + ": inv lost/fixed at end, restarting");
        restart_count = restart_count + 1;
        defineGlobal("restart_count", restart_count);
        if (restart_count > 100) {
            catn("Too many restarts at end");
            sim.simulationFinished();
            return;
        }
        sim.readFromPopulationFile(STATE_FILE);
        setSeed(seed + restart_count * 1000);
        community.rescheduleScriptBlock(self, ticks=sim.cycle + (END_TICK - INV_TICK));
        return;
    }

    // Sample
    individuals = p1.individuals;
    ss_list = c();
    ii_list = c();
    for (ind in individuals) {
        cnt = sum(ind.haplosomes.containsMarkerMutation(m2, bp_left));
        if (cnt == 0) ss_list = c(ss_list, ind);
        else if (cnt == 2) ii_list = c(ii_list, ind);
    }

    n_s = min(c(n_samp, size(ss_list)));
    n_i = min(c(n_samp, size(ii_list)));

    if (n_s < 2 | n_i < 2) {
        catn("Insufficient SS/II, restarting");
        restart_count = restart_count + 1;
        defineGlobal("restart_count", restart_count);
        if (restart_count > 100) {
            sim.simulationFinished();
            return;
        }
        sim.readFromPopulationFile(STATE_FILE);
        setSeed(seed + restart_count * 1000);
        community.rescheduleScriptBlock(self, ticks=sim.cycle + (END_TICK - INV_TICK));
        return;
    }

    catn("tick " + sim.cycle + ": SAMPLING SS=" + size(ss_list) +
         ", II=" + size(ii_list) + ", restarts=" + restart_count);

    sampled_s = sample(ss_list, n_s);
    sampled_i = sample(ii_list, n_i);
    all_sampled = c(sampled_s, sampled_i);
    haps = all_sampled.haplosomes;

    out = "# SLiM inversion, n_SS_haps=" + (n_s*2) + ", n_II_haps=" + (n_i*2) +
          ", L=" + L + "\n";
    out = out + "# seed=" + seed + ", Ne=" + Ne + ", bp=[" + bp_left + "," +
          bp_right + "], inv_age=" + (END_TICK - INV_TICK) +
          ", restarts=" + restart_count + "\n";

    muts = sim.mutations;
    muts = muts[muts.mutationType == m1];
    keep = c();
    for (j in seqLen(size(muts))) {
        cnt = sum(haps.containsMutations(muts[j]));
        if (cnt > 0 & cnt < size(haps)) keep = c(keep, j);
    }
    if (size(keep) > 0) muts = muts[keep];
    else muts = object();

    positions = muts.position;
    if (size(positions) > 0) {
        ord = order(positions);
        muts = muts[ord];
        positions = positions[ord];
    }

    out = out + "positions:";
    for (p in positions) out = out + " " + p;
    out = out + "\n";
    for (h in haps) {
        line = "";
        for (m in muts) line = line + (h.containsMutations(m) ? "1" else "0");
        out = out + line + "\n";
    }
    writeFile(outfile, out);
    // Clean up state file
    deleteFile(STATE_FILE);
    catn("Wrote " + outfile);
    sim.simulationFinished();
}
