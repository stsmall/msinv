// SLiM forward simulation of a neutral population with a marker
// mutation (for validating msinv against exact forward simulation).
//
// Note: This models a standard panmictic coalescent. The "inversion"
// is just a marker we use to split haplotypes into two groups for
// validation — there's no actual recombination suppression.
//
// For validating full inversion dynamics we'd need a custom SLiM
// script that suppresses recombination in heterokaryotypes, which
// is beyond the scope of this validation.
//
// Parameters (set via -d on command line):
//   Ne, L, mu, r: standard coalescent parameters
//   p_init: initial marker frequency
//   burn_in: generations of burn-in before sampling
//   bp_mark: position of marker mutation
//   n_samp: number of diploid individuals to sample
//   seed: random seed
//   outfile: output file path

initialize() {
    if (!exists("Ne")) defineConstant("Ne", 10000);
    if (!exists("L")) defineConstant("L", 100000);
    if (!exists("mu")) defineConstant("mu", 1e-8);
    if (!exists("r")) defineConstant("r", 1e-8);
    if (!exists("p_init")) defineConstant("p_init", 0.5);
    if (!exists("burn_in")) defineConstant("burn_in", 80000);   // 8 * Ne
    if (!exists("bp_mark")) defineConstant("bp_mark", 30000);
    if (!exists("n_samp")) defineConstant("n_samp", 10);
    if (!exists("seed")) defineConstant("seed", 42);
    if (!exists("outfile")) defineConstant("outfile", "slim_out.txt");

    setSeed(seed);

    initializeMutationRate(mu);
    initializeMutationType("m1", 0.5, "f", 0.0);
    m1.convertToSubstitution = F;
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElement(g1, 0, L-1);
    initializeRecombinationRate(r);
}

1 early() {
    sim.addSubpop("p1", Ne);
    // Introduce marker mutation at frequency p_init
    n_mark = asInteger(round(2 * Ne * p_init));
    target = sample(p1.haplosomes, n_mark);
    target.addNewDrawnMutation(m1, bp_mark);
}

// Track marker frequency occasionally
1: late() {
    if (sim.cycle % 20000 == 0) {
        mark_count = sum(p1.haplosomes.containsMarkerMutation(m1, bp_mark));
        catn("gen " + sim.cycle + ": marker freq = " +
             (mark_count / (2.0 * Ne)));
    }
}

// Sample after burn_in generations
80001 late() {
    sampled = sample(p1.individuals, n_samp);
    haps = sampled.haplosomes;

    out = "# SLiM output, n=" + size(haps) + ", L=" + L + "\n";
    out = out + "# seed=" + seed + ", gen=" + sim.cycle +
          ", Ne=" + Ne + "\n";

    // Only keep mutations at segregating sites
    muts = sim.mutations;
    muts = muts[muts.mutationType == m1];

    // Filter: only those that are variable in our sample
    keep = c();
    for (i in seqLen(size(muts))) {
        count = sum(haps.containsMutations(muts[i]));
        if (count > 0 & count < size(haps)) {
            keep = c(keep, i);
        }
    }
    if (size(keep) > 0) {
        muts = muts[keep];
    } else {
        muts = object();
    }

    positions = muts.position;
    if (size(positions) > 0) {
        order = order(positions);
        muts = muts[order];
        positions = positions[order];
    }

    out = out + "positions:";
    for (p in positions) {
        out = out + " " + p;
    }
    out = out + "\n";

    for (h in haps) {
        line = "";
        for (m in muts) {
            if (h.containsMutations(m)) {
                line = line + "1";
            } else {
                line = line + "0";
            }
        }
        out = out + line + "\n";
    }

    writeFile(outfile, out);
    catn("Wrote " + outfile);
    sim.simulationFinished();
}
