// SLiM forward simulation of an inversion with gene conversion
//
// Simulates a chromosome with an inversion in a single population.
// The inversion arises at generation t_start and is tracked.
// Output: haplotype matrix at specified sampling generations.
//
// Parameters (all set via -d on command line):
//   Ne: effective population size
//   L: chromosome length in bp
//   mu: mutation rate per bp per gen
//   r: recombination rate per bp per gen (between same karyotype)
//   gamma: gene conversion rate per bp per gen (between karyotypes)
//   p_init: initial inversion frequency (when introduced)
//   t_inv: inversion age in generations (time before sampling)
//   bp_left: inversion left breakpoint (bp position)
//   bp_right: inversion right breakpoint (bp position)
//   n_samp: number of diploid samples to draw
//   seed: random seed
//   outfile: output file path

initialize() {
    if (!exists("Ne")) defineConstant("Ne", 10000);
    if (!exists("L")) defineConstant("L", 100000);
    if (!exists("mu")) defineConstant("mu", 1e-8);
    if (!exists("r")) defineConstant("r", 1e-8);
    if (!exists("gamma")) defineConstant("gamma", 1e-10);
    if (!exists("p_init")) defineConstant("p_init", 0.5);
    if (!exists("t_inv")) defineConstant("t_inv", 20000);
    if (!exists("bp_left")) defineConstant("bp_left", 30000);
    if (!exists("bp_right")) defineConstant("bp_right", 70000);
    if (!exists("n_samp")) defineConstant("n_samp", 10);
    if (!exists("seed")) defineConstant("seed", 42);
    if (!exists("outfile")) defineConstant("outfile", "slim_out.txt");

    setSeed(seed);

    initializeMutationRate(mu);

    // m1: neutral mutations
    initializeMutationType("m1", 0.5, "f", 0.0);
    m1.convertToSubstitution = F;

    // g1: non-inversion genomic element
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElement(g1, 0, L-1);

    // Recombination rate: normal outside, zero between karyotypes inside
    // We model this by tracking inversion as a marker mutation and using
    // a simple approach: all chromosomes recombine normally; we'll handle
    // the inversion suppression by filtering.
    initializeRecombinationRate(r);
}

// Generation 1: create population, introduce inversion
1 early() {
    sim.addSubpop("p1", Ne);

    // Introduce inversion mutation at frequency p_init
    n_inv = asInteger(round(2 * Ne * p_init));
    target = sample(p1.haplosomes, n_inv);
    target.addNewDrawnMutation(m1, bp_left);  // marker for inversion
}

// Track inversion frequency
1: late() {
    if (sim.cycle % 1000 == 0) {
        inv_count = sum(p1.haplosomes.containsMarkerMutation(m1, bp_left));
        catn("gen " + sim.cycle + ": inv freq = " + (inv_count / (2.0 * Ne)));
    }
}

// Sample at t_inv generations (after 4*Ne burn-in)
// For Ne=10000, need ~40000 gen to reach coalescent equilibrium
60000 late() {
    // Sample n_samp diploid individuals = 2*n_samp haplosomes
    sampled = sample(p1.individuals, n_samp);
    haps = sampled.haplosomes;

    // Write VCF-like output
    out = "# SLiM output, n=" + size(haps) + ", L=" + L + "\n";
    out = out + "# seed=" + seed + ", gen=" + sim.cycle + "\n";

    // Get all segregating sites
    muts = sim.mutations;
    muts = muts[muts.mutationType == m1];
    // Sort by position
    positions = muts.position;
    order = order(positions);
    muts = muts[order];
    positions = positions[order];

    out = out + "positions:";
    for (p in positions) {
        out = out + " " + p;
    }
    out = out + "\n";

    // Haplotype matrix: one line per haplosome
    for (h in haps) {
        line = "";
        for (m in muts) {
            if (h.containsMutations(m)) {
                line = line + "1";
            } else {
                line = line + "0";
            }
        }
        out = out + line + "\n";
    }

    writeFile(outfile, out);
    catn("Wrote " + outfile);
    sim.simulationFinished();
}
